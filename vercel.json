{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/plan", "destination": "/plan/index.html" },
    { "source": "/agentic-stack", "destination": "/agentic-stack/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
